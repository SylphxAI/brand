{
  "$description": "Sylphx design tokens, direction Altitude (2026-11-16; directions/2026-11-altitude.md): high, clear air. Near-neutral cool surfaces, ink for primary actions, one azure accent, and one brand gradient (the current) kept for the mark and rare brand moments. The one source for colour, type, radius, spacing and motion on every Sylphx surface. scripts/build_tokens.py generates tokens/brand.css; surfaces consume the CSS or this JSON and never copy a value by hand.",
  "mark": {
    "$description": "The logo's own colours, which logo/construction/mark.spec.json draws with. The mark is filled with the current (current-start, current-mid, current-end); ink and paper set the wordmark; field is the ground of the tile, favicon and app icon.",
    "accent": {
      "$type": "color",
      "$value": "#2FA8FF",
      "$description": "Azure, the middle of the current: the mark's single flat colour where a gradient cannot be used."
    },
    "accent-on-dark": {
      "$type": "color",
      "$value": "#2FA8FF",
      "$description": "The same azure; it holds on dark grounds."
    },
    "ink": {
      "$type": "color",
      "$value": "#0A0D14",
      "$description": "Wordmark on light grounds."
    },
    "paper": {
      "$type": "color",
      "$value": "#F4F6FA",
      "$description": "Wordmark on dark grounds."
    },
    "field": {
      "$type": "color",
      "$value": "#0A0D14",
      "$description": "Ground of the tile, favicon and app icon."
    },
    "current-start": {
      "$type": "color",
      "$value": "#2F4BFF",
      "$description": "The current, first stop: deep blue."
    },
    "current-mid": {
      "$type": "color",
      "$value": "#2FA8FF",
      "$description": "The current, middle stop at 55%: azure."
    },
    "current-end": {
      "$type": "color",
      "$value": "#9FE3FF",
      "$description": "The current, last stop: pale sky."
    },
    "dawn": {
      "$type": "color",
      "$value": "#FFB58A",
      "$description": "Warm counterpoint for illustration and rare highlights. Not a text or interface colour."
    }
  },
  "gradient": {
    "$description": "The one brand gradient. For the mark and at most one brand moment per page; never for text, controls or status.",
    "current": {
      "$type": "gradient",
      "$value": [
        {
          "color": "#2F4BFF",
          "position": 0
        },
        {
          "color": "#2FA8FF",
          "position": 0.55
        },
        {
          "color": "#9FE3FF",
          "position": 1
        }
      ],
      "$extensions": {
        "com.sylphx.angle": "135deg"
      },
      "$description": "The current: deep blue to azure to pale sky, at 135deg."
    }
  },
  "status": {
    "$description": "Status colours on the code ground (`code-background`, ink #0A0D14 in both themes), at least 4.5:1 there. Theme-independent; the light theme's status tokens fail on that ground.",
